---

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  canonicalPath?: string; // e.g. "/homes/page/2"
  socialImage?: string;
  prevHref?: string;      // e.g. "/homes"
  nextHref?: string;      // e.g. "/homes/page/3"
}

const {
    title = 'Utah Oasis Homes | Custom Homes in Utah',
    description = 'Custom homes shaped by the way you live, the people you gather, and the Utah landscape outside your door.',
  robots = "index,follow",
    canonicalPath,
    socialImage = "/branding/uoh-og.png",
    prevHref,
    nextHref,
} = Astro.props;

// Canonical URL:
// - Default: current URL (hardened: strips query/hash)
// - Optional override: canonicalPath (absolute via Astro.site when available)
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;

const canonical = canonicalPath
  ? new URL(canonicalPath, siteOrigin)
  : new URL(Astro.url);

canonical.search = "";
canonical.hash = "";
const canonicalUrl = canonical.href;
const socialImageUrl = new URL(socialImage, siteOrigin).href;

// Prev/Next (absolute for <head> links)
const prevUrl = prevHref ? new URL(prevHref, siteOrigin).href : null;
const nextUrl = nextHref ? new URL(nextHref, siteOrigin).href : null;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${siteOrigin.replace(/\/$/, "")}/#organization`,
  name: "Utah Oasis Homes",
  url: `${siteOrigin.replace(/\/$/, "")}/`,
  logo: new URL("/branding/uoh-og.png", siteOrigin).href,
  image: new URL("/branding/uoh-og.png", siteOrigin).href,
  telephone: "+1-801-859-3317",
  email: "utahoasishomes@gmail.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "2052 West 700 South, Unit H",
    addressLocality: "Springville",
    addressRegion: "UT",
    postalCode: "84664",
    addressCountry: "US",
  },
  areaServed: [
    {
      "@type": "AdministrativeArea",
      name: "Wasatch Front, Utah",
    },
    {
      "@type": "AdministrativeArea",
      name: "Southern Utah",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="512x512" href="/branding/uoh-favicon-512.png" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Utah Oasis Homes" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    
    <link rel="canonical" href={canonicalUrl} />
    {prevUrl ? <link rel="prev" href={prevUrl} /> : null}
    {nextUrl ? <link rel="next" href={nextUrl} /> : null}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    </head>

  <body class="site-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <Header />
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    
    <footer class="site-footer">
      <Footer />
    </footer>
  </body>
</html>
