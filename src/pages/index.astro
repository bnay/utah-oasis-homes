---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const featuredHomes = (await getCollection('homes'))
  .filter((home) => home.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
  
const customerStories = (await getCollection('stories'))
  .filter((story) => story.data.featured)
  .sort((a, b) => {
    const orderA = a.data.order ?? 999;
    const orderB = b.data.order ?? 999;

    if (orderA !== orderB) {
      return orderA - orderB;
    }

    return a.data.title.localeCompare(b.data.title);
  });

const storyPreviews = customerStories.map((story) => ({
  title: story.data.title,
  customers: story.data.customers,
  excerpt: story.data.excerpt,
  href: `/client-stories#${story.slug}`,
}));

const initialStories = storyPreviews.slice(0, 2);

const featuredImageDimensions: Record<
  string,
  { width: number; height: number }
> = {
  "alpine-custom": {
    width: 1830,
    height: 830,
  },
  "mapleton-modern": {
    width: 2000,
    height: 1500,
  },
  "desert-contemporary": {
    width: 2000,
    height: 1500,
  },
  "zion-estate": {
    width: 1024,
    height: 683,
  },
};

---

<BaseLayout
  title="Utah Oasis Homes | Custom Homes in Utah"
  description="Custom homes shaped by the way you live, the people you gather, and the Utah landscape outside your door."
>

<section class="hero" id="hero">
  <img
    class="hero-background"
    src="/images/hero-1600.webp"
    srcset="
      /images/hero-960.webp 960w,
      /images/hero-1600.webp 1600w,
      /images/hero.jpg 2560w
    "
    sizes="100vw"
    alt=""
    aria-hidden="true"
    width="1600"
    height="1067"
    fetchpriority="high"
    decoding="async"
  />
  
  <div class="hero-overlay"></div>

  <div class="hero-shell">
	<div class="hero-logo-row">
    <img
      class="hero-logo-mark"
      src="/branding/uoh-logo-stacked-480.webp"
      srcset="
        /branding/uoh-logo-stacked-320.webp 320w,
        /branding/uoh-logo-stacked-480.webp 480w
      "
      sizes="(max-width: 900px) 135px, 240px"
      alt=""
      aria-hidden="true"
      width="480"
      height="321"
      decoding="async"
    />
  </div>

<div class="hero-eyebrow">
  WASATCH FRONT &amp; SOUTHERN UTAH
</div>



    <!-- Main hero content -->
    <div class="hero-body">
      <h1 class="hero-title">Every Home Should Be an Oasis.</h1>

      <p class="hero-subtitle">
        A home shaped around the way you live, the people you gather, and the landscape outside your
        door—thoughtfully designed and carefully built to feel distinctly yours.
      </p>

      <div class="hero-ctas">
        <a href="/homes" class="btn btn-primary">View Our Homes</a>
        <a href="/start" class="btn btn-ghost">Start Your Home</a>
      </div>

      <div class="hero-meta">
        <span><strong>Wasatch Front &amp; Southern Utah</strong></span>
      </div>
    </div>
  </div>
</section>

  <section class="section" id="differentiators">
    <div class="section-header">
      <h2 class="section-title">A More Thoughtful Way to Build</h2>
      <p class="section-subtitle">
        Clear guidance, careful decisions, and a home shaped around the way you want to live.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3>Designed for Everyday Escape</h3>
        <p>
          Pools, courtyards, and seamless indoor–outdoor spaces that make home feel like the place you
          would rather be.
        </p>
      </article>
      <article class="card">
        <h3>Shaped by the Landscape</h3>
        <p>Desert cliffs, mountain views, and natural light drive every design decision.</p>
      </article>
      <article class="card">
        <h3>Guided from Start to Finish</h3>
        <p>Clear communication, thoughtful guidance, and steady progress at every stage.</p>
      </article>
      <article class="card">
        <h3>Crafted for the Long Term</h3>
        <p>Thoughtful materials, careful detailing, and workmanship designed to endure.</p>
      </article>
    </div>
  </section>

  <section class="section" id="featured-homes">
    <div class="section-header">
      <h2 class="section-title">Selected Homes</h2>
      <p class="section-subtitle">
        A collection of homes shaped by their setting, their owners, and the way each family lives.
      </p>
    </div>
    <div class="card-grid">
      {featuredHomes.map((home) => (
        <article class="card featured-home-card">
          <a href={`/homes/${home.slug}`} class="featured-home-link">
            <div class="featured-home-media">
              <img
                src={home.data.coverImage}
                alt={`${home.data.title} in ${home.data.location}`}
                width={featuredImageDimensions[home.slug]?.width}
                height={featuredImageDimensions[home.slug]?.height}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="featured-home-body">
              <h3>{home.data.title}</h3>
              <p class="featured-home-location">{home.data.location}</p>
              <p>{home.body}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div style="margin-top: 1.25rem;">
      <a href="/homes" class="btn btn-ghost">Explore Our Homes</a>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="section-header">
      <h2 class="section-title">A Calm, Clear Building Experience</h2>
      <p class="section-subtitle">
        A thoughtful process that keeps decisions clear, communication steady, and you confident at
        every stage.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3>01 — Discover</h3>
        <p>
          We learn your vision, lifestyle, budget, and land so we can design a home around the way
          you live.
        </p>
      </article>
      <article class="card">
        <h3>02 — Design</h3>
        <p>
          Working with trusted architects and designers, we shape a home that captures your
          priorities and maximizes your site.
        </p>
      </article>
      <article class="card">
        <h3>03 — Build</h3>
        <p>
          Clear schedules, regular updates, and careful craftsmanship keep the work moving with purpose
          and transparency.
        </p>
      </article>
      <article class="card">
        <h3>04 — Live</h3>
        <p>
          Settle into a home that feels restorative, personal, and deeply connected to the way you live.
        </p>
      </article>
    </div>
  </section>

  <section class="section" id="locations">
    <div class="section-header">
      <h2 class="section-title">Designed for Utah’s Most Inspiring Settings</h2>
      <p class="section-subtitle">
        From red rock desert to mountain ridgelines, each home is shaped to feel naturally connected to
        its surroundings.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3>Wasatch Front</h3>
        <p>
          Refined custom homes designed for family living, views, and four-season comfort along the
          Wasatch corridor.
        </p>
      </article>
      <article class="card">
        <h3>Southern Utah & Sand Hollow</h3>
        <p>
          Desert modern and resort-style homes oriented to dramatic cliffs, water, and expansive
          views.
        </p>
      </article>
    </div>
  </section>

    <section
    class="section"
    id="testimonials"
    data-story-pool={JSON.stringify(storyPreviews)}
  >
    <div class="section-header">
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">
        Reflections from homeowners on the experience of designing and building with Utah Oasis Homes.
      </p>
    </div>

    <div class="card-grid testimonials-home-grid">
      {initialStories.map((story) => (
        <article class="card testimonial-home-card">
          <h3 class="testimonial-home-title">
            {story.title}
          </h3>

          <p class="testimonial-home-quote">
            “{story.excerpt}”
          </p>

          <p class="testimonial-home-attribution">
            {story.customers}
          </p>

          <a
            class="testimonial-home-link"
            href={story.href}
          >
            Read full story →
          </a>
        </article>
      ))}
    </div>

    <div style="margin-top: 1.25rem;">
      <a href="/client-stories" class="btn btn-ghost">
        View All Client Stories
      </a>
    </div>
  </section>

  <section class="primary-cta" id="primary-cta">
    <h2>Let’s Begin with a Conversation</h2>
    <p>
      Share what you’re imagining, where you are in the process, and what matters most to you. We’ll
      help you understand the next step.
    </p>
    <a href="/start" class="btn btn-primary">Start Your Home</a>
  </section>
  
<script>
  const storySection =
    document.querySelector<HTMLElement>("#testimonials");

  if (storySection?.dataset.storyPool) {
    try {
      const stories = JSON.parse(
        storySection.dataset.storyPool
      ) as Array<{
        title: string;
        customers: string;
        excerpt: string;
        href: string;
      }>;

      const cards = Array.from(
        storySection.querySelectorAll<HTMLElement>(
          ".testimonial-home-card"
        )
      );

      if (stories.length >= 2 && cards.length >= 2) {
        const dayNumber = Math.floor(
          Date.now() / 86_400_000
        );

        const firstIndex = dayNumber % stories.length;

        const rotationCycle = Math.floor(
          dayNumber / stories.length
        );

        const partnerOffset =
          1 + (rotationCycle % (stories.length - 1));

        const secondIndex =
          (firstIndex + partnerOffset) % stories.length;

        const selectedStories = [
          stories[firstIndex],
          stories[secondIndex],
        ];

        cards.slice(0, 2).forEach((card, index) => {
          const story = selectedStories[index];

          const title =
            card.querySelector<HTMLElement>(
              ".testimonial-home-title"
            );

          const quote =
            card.querySelector<HTMLElement>(
              ".testimonial-home-quote"
            );

          const attribution =
            card.querySelector<HTMLElement>(
              ".testimonial-home-attribution"
            );

          const link =
            card.querySelector<HTMLAnchorElement>(
              ".testimonial-home-link"
            );

          if (title) {
            title.textContent = story.title;
          }

          if (quote) {
            quote.textContent = `“${story.excerpt}”`;
          }

          if (attribution) {
            attribution.textContent = story.customers;
          }

          if (link) {
            link.href = story.href;
          }
        });
      }
    } catch {
      // Keep the server-rendered fallback stories if the data cannot be read.
    }
  }
</script>

</BaseLayout>
