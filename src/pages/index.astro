---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const featuredHomes = (await getCollection('homes'))
  .filter((home) => home.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
  
const customerStories = (await getCollection('stories'))
  .filter((story) => story.data.featured)
  .sort((a, b) => {
    const orderA = a.data.order ?? 999;
    const orderB = b.data.order ?? 999;

    if (orderA !== orderB) {
      return orderA - orderB;
    }

    return a.data.title.localeCompare(b.data.title);
  });

const storyPreviews = customerStories.map((story) => ({
  title: story.data.title,
  customers: story.data.customers,
  excerpt: story.data.excerpt,
  href: `/client-stories#${story.slug}`,
}));

const initialStories = storyPreviews.slice(0, 2);

const featuredImageDimensions: Record<
  string,
  { width: number; height: number }
> = {
  "alpine-custom": {
    width: 1830,
    height: 830,
  },
  "mapleton-modern": {
    width: 2000,
    height: 1500,
  },
  "desert-contemporary": {
    width: 2000,
    height: 1500,
  },
  "zion-estate": {
    width: 1024,
    height: 683,
  },
};

---

<BaseLayout
  title="Utah Custom Home Builder | Utah Oasis Homes"
  description="Utah Oasis Homes builds custom homes across the Wasatch Front and Southern Utah with direct builder involvement, purposeful design, and enduring craftsmanship."
  canonicalPath="/"
  socialImageAlt="Utah Oasis Homes custom home builder"
>

<section class="hero" id="hero">
  <img
    class="hero-background"
    src="/images/hero-1600.webp"
    srcset="
      /images/hero-960.webp 960w,
      /images/hero-1600.webp 1600w,
      /images/hero.jpg 2560w
    "
    sizes="100vw"
    alt=""
    aria-hidden="true"
    width="1600"
    height="1067"
    fetchpriority="high"
    decoding="async"
  />
  
  <div class="hero-overlay"></div>

  <div class="hero-shell">
	<div class="hero-logo-row">
    <img
      class="hero-logo-mark"
      src="/branding/uoh-logo-stacked-480.webp"
      srcset="
        /branding/uoh-logo-stacked-320.webp 320w,
        /branding/uoh-logo-stacked-480.webp 480w
      "
      sizes="(max-width: 900px) 135px, 240px"
      alt=""
      aria-hidden="true"
      width="480"
      height="321"
      decoding="async"
    />
  </div>

<div class="hero-eyebrow">
  WASATCH FRONT &amp; SOUTHERN UTAH
</div>



    <!-- Main hero content -->
    <div class="hero-body">
      <h1 class="hero-title">Every Home Should Be an Oasis.</h1>

      <p class="hero-subtitle">
        A home planned for your routines, your relationships, and the land around it—then brought to
        life with disciplined coordination and enduring craftsmanship.
      </p>

      <div class="hero-ctas">
        <a href="/homes" class="btn btn-primary">View Our Homes</a>
        <a href="/start" class="btn btn-ghost">Start Your Home</a>
      </div>

      <div class="hero-meta">
        <span><strong>Wasatch Front &amp; Southern Utah</strong></span>
      </div>
    </div>
  </div>
</section>

  <section class="section" id="differentiators">
    <div class="section-header">
      <h2 class="section-title">A Better Building Experience, by Design</h2>
      <p class="section-subtitle">
        Direct access to your builder, purposeful decisions, and steady execution from the first
        conversation through move-in.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3>Designed for Everyday Escape</h3>
        <p>
          Courtyards, pools, and indoor–outdoor rooms turn ordinary days into time well spent at home.
        </p>
      </article>
      <article class="card">
        <h3>Responsive to the Land</h3>
        <p>Sun, views, privacy, and climate inform the home’s orientation, openings, and outdoor spaces.</p>
      </article>
      <article class="card">
        <h3>Guided from Start to Finish</h3>
        <p>Direct involvement from Troy, regular updates, and defined next steps keep the work moving.</p>
      </article>
      <article class="card">
        <h3>Crafted for the Long Term</h3>
        <p>Durable materials, precise detailing, and proven tradespeople support lasting quality.</p>
      </article>
    </div>
  </section>

  <section class="section" id="featured-homes">
    <div class="section-header">
      <h2 class="section-title">Selected Homes</h2>
      <p class="section-subtitle">
        Distinct residences that respond to their owners, their properties, and the demands of daily life.
      </p>
    </div>
    <div class="card-grid">
      {featuredHomes.map((home) => (
        <article class="card featured-home-card">
          <a href={`/homes/${home.slug}`} class="featured-home-link">
            <div class="featured-home-media">
              <img
                src={home.data.coverImage}
                alt={home.data.coverAlt}
                width={featuredImageDimensions[home.slug]?.width}
                height={featuredImageDimensions[home.slug]?.height}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="featured-home-body">
              <h3>{home.data.title}</h3>
              <p class="featured-home-location">{home.data.location}</p>
              <p>{home.body}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div style="margin-top: 1.25rem;">
      <a href="/homes" class="btn btn-ghost">Explore Our Homes</a>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="section-header">
      <div class="pill-eyebrow">The Journey</div>
      <h2 class="section-title">Your Home-Building Journey</h2>
      <p class="section-subtitle">
        Four connected stages take your home from the first conversation through move-in.
      </p>
    </div>
    <div class="card-grid experience-overview-grid">
      <article class="card experience-overview-card">
        <span class="experience-overview-number" aria-hidden="true">01</span>
        <h3>Discover</h3>
        <p>Define the vision, priorities, property, and investment.</p>
      </article>
      <article class="card experience-overview-card">
        <span class="experience-overview-number" aria-hidden="true">02</span>
        <h3>Design</h3>
        <p>Translate your priorities, property, and budget into a cohesive plan.</p>
      </article>
      <article class="card experience-overview-card">
        <span class="experience-overview-number" aria-hidden="true">03</span>
        <h3>Build</h3>
        <p>Coordinate trades, schedules, and quality control with direct oversight.</p>
      </article>
      <article class="card experience-overview-card">
        <span class="experience-overview-number" aria-hidden="true">04</span>
        <h3>Live</h3>
        <p>Move into a home planned for how you want each day to work and feel.</p>
      </article>
    </div>
    <div class="experience-overview-action">
      <a href="/process" class="btn btn-ghost">See How We Build</a>
    </div>
  </section>

  <section class="section" id="locations">
    <div class="section-header">
      <h2 class="section-title">Built for Two Distinct Utah Landscapes</h2>
      <p class="section-subtitle">
        The Wasatch Front and Southern Utah call for different responses to climate, views, materials,
        and outdoor living.
      </p>
    </div>
    <div class="card-grid">
      <article class="card service-area-card">
        <h3>Wasatch Front</h3>
        <p>
          Refined custom homes designed for family living, views, and four-season comfort along the
          Wasatch corridor.
        </p>
        <a class="service-area-link" href="/custom-homes/wasatch-front">
          Explore Wasatch Front custom homes →
        </a>
      </article>
      <article class="card service-area-card">
        <h3>Southern Utah & Sand Hollow</h3>
        <p>
          Desert modern and resort-style homes oriented to dramatic cliffs, water, and expansive
          views.
        </p>
        <a class="service-area-link" href="/custom-homes/southern-utah">
          Explore Southern Utah custom homes →
        </a>
      </article>
    </div>
  </section>

    <section
    class="section"
    id="testimonials"
    data-story-pool={JSON.stringify(storyPreviews)}
  >
    <div class="section-header">
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">
        Reflections from homeowners on the experience of designing and building with Utah Oasis Homes.
      </p>
    </div>

    <div class="card-grid testimonials-home-grid">
      {initialStories.map((story) => (
        <article class="card testimonial-home-card">
          <h3 class="testimonial-home-title">
            {story.title}
          </h3>

          <p class="testimonial-home-quote">
            “{story.excerpt}”
          </p>

          <p class="testimonial-home-attribution">
            {story.customers}
          </p>

          <a
            class="testimonial-home-link"
            href={story.href}
          >
            Read full story →
          </a>
        </article>
      ))}
    </div>

    <div style="margin-top: 1.25rem;">
      <a href="/client-stories" class="btn btn-ghost">
        View All Client Stories
      </a>
    </div>
  </section>

  <section class="primary-cta" id="primary-cta">
    <h2>Let’s Begin with a Conversation</h2>
    <p>
      Share what you’re imagining, where you are in the process, and what matters most to you. We’ll
      help you understand the next step.
    </p>
    <a href="/start" class="btn btn-primary">Start Your Home</a>
  </section>
  
<script>
  const storySection =
    document.querySelector<HTMLElement>("#testimonials");

  if (storySection?.dataset.storyPool) {
    try {
      const stories = JSON.parse(
        storySection.dataset.storyPool
      ) as Array<{
        title: string;
        customers: string;
        excerpt: string;
        href: string;
      }>;

      const cards = Array.from(
        storySection.querySelectorAll<HTMLElement>(
          ".testimonial-home-card"
        )
      );

      if (stories.length >= 2 && cards.length >= 2) {
        const dayNumber = Math.floor(
          Date.now() / 86_400_000
        );

        const firstIndex = dayNumber % stories.length;

        const rotationCycle = Math.floor(
          dayNumber / stories.length
        );

        const partnerOffset =
          1 + (rotationCycle % (stories.length - 1));

        const secondIndex =
          (firstIndex + partnerOffset) % stories.length;

        const selectedStories = [
          stories[firstIndex],
          stories[secondIndex],
        ];

        cards.slice(0, 2).forEach((card, index) => {
          const story = selectedStories[index];

          const title =
            card.querySelector<HTMLElement>(
              ".testimonial-home-title"
            );

          const quote =
            card.querySelector<HTMLElement>(
              ".testimonial-home-quote"
            );

          const attribution =
            card.querySelector<HTMLElement>(
              ".testimonial-home-attribution"
            );

          const link =
            card.querySelector<HTMLAnchorElement>(
              ".testimonial-home-link"
            );

          if (title) {
            title.textContent = story.title;
          }

          if (quote) {
            quote.textContent = `“${story.excerpt}”`;
          }

          if (attribution) {
            attribution.textContent = story.customers;
          }

          if (link) {
            link.href = story.href;
          }
        });
      }
    } catch {
      // Keep the server-rendered fallback stories if the data cannot be read.
    }
  }
</script>

</BaseLayout>
