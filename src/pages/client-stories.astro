---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const stories = await getCollection("stories");

stories.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;

  if (orderA !== orderB) {
    return orderA - orderB;
  }

  return a.data.title.localeCompare(b.data.title);
});

const renderedStories = await Promise.all(
  stories.map(async (story) => {
    const { Content } = await render(story);

    return {
      story,
      Content,
    };
  })
);
---

<BaseLayout
  title="Custom Home Client Stories | Utah Oasis Homes"
  description="Read what Utah homeowners have shared about working directly with Utah Oasis Homes, from early planning and construction through life in the finished home."
  canonicalPath="/client-stories"
>
  <section class="section client-stories-page">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol class="breadcrumbs-list">
        <li class="breadcrumbs-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumbs-separator" aria-hidden="true">→</li>
        <li class="breadcrumbs-item breadcrumbs-current">
          Client Stories
        </li>
      </ol>
    </nav>

    <header class="stories-page-intro">
      <div class="stories-page-copy">
        <div class="pill-eyebrow">Homeowner Experiences</div>
        <h1>What It Feels Like to Build With Us</h1>
        <p>
          A custom home is measured by more than the finished rooms. Hear directly from homeowners about
          the decisions, communication, workmanship, and follow-through they experienced while building
          with Utah Oasis Homes.
        </p>
      </div>

      {stories[0] ? (
        <aside class="stories-page-feature" aria-label="Featured homeowner reflection">
          <span class="stories-page-quote-mark" aria-hidden="true">“</span>
          <p>“{stories[0].data.excerpt}”</p>
          <footer>— {stories[0].data.customers}</footer>
        </aside>
      ) : null}
    </header>

    <div class="stories-page-heading">
      <div>
        <div class="pill-eyebrow">In Their Own Words</div>
        <h2>Complete homeowner stories</h2>
      </div>
      <p>Real accounts of the experience before, during, and after construction.</p>
    </div>

    <div class="client-stories-list">
      {renderedStories.map(({ story, Content }, index) => (
        <article class="card client-story" id={story.slug}>
          <header class="client-story-header">
            <span class="client-story-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h2 class="client-story-title">{story.data.title}</h2>
          </header>

          <div class="client-story-content">
            <Content />
          </div>

          <footer class="client-story-attribution">
            <span aria-hidden="true">—</span>
            <span>{story.data.customers}</span>
          </footer>
        </article>
      ))}
    </div>

    <section class="stories-page-cta" aria-labelledby="stories-cta-title">
      <div>
        <div class="pill-eyebrow">Begin Your Own Story</div>
        <h2 id="stories-cta-title">Let’s talk about the home you have in mind.</h2>
        <p>
          Start with a straightforward conversation about your property, priorities, and timing.
        </p>
      </div>
      <a href="/start" class="btn btn-primary">Start a Conversation</a>
    </section>
  </section>
</BaseLayout>
