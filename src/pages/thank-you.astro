---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | Utah Oasis Homes"
  description="Thank you for contacting Utah Oasis Homes. We look forward to learning more about your custom home vision."
  robots="noindex,follow"
  canonicalPath="/thank-you"
>
  <section class="thank-you-page" aria-labelledby="thank-you-title">
    <div class="thank-you-card">
      <div class="pill-eyebrow">Your journey has begun</div>

      <h1 id="thank-you-title" class="thank-you-title">
        Thank You
      </h1>

      <p class="thank-you-lead">
        We’ve received your information and look forward to learning more about
        the home you’re imagining.
      </p>

      <p class="thank-you-copy">
        A member of the Utah Oasis Homes team will review your request and reach
        out soon. Until then, you’re welcome to explore our homes and learn more
        about the way we approach the building experience.
      </p>

      <div class="thank-you-actions">
        <a href="/homes" class="btn btn-primary">
          Explore Our Homes
        </a>

        <a href="/process" class="btn btn-secondary">
          View Our Process
        </a>
      </div>
    </div>
  </section>
</BaseLayout>