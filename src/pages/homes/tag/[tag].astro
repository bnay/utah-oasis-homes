---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HomeCard from "../../../components/HomeCard.astro";
import { getCollection } from "astro:content";

export const prerender = true;

function norm(s: unknown) {
  return String(s ?? "")
    .replace(/\u200B/g, "")
    .trim()
    .toLowerCase();
}

function toTagSlug(t: unknown) {
  return String(t ?? "")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

// Required for prerendered dynamic routes
export async function getStaticPaths() {
  // Keep slugger local so it’s always available during Astro’s route build step
  const slugger = (t: unknown) =>
    String(t ?? "")
      .trim()
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  const homes = await getCollection("homes");
  const tags = Array.from(new Set(homes.flatMap((h) => h.data.tags ?? [])));

  return tags.map((t) => ({ params: { tag: slugger(t) } }));
}

const homes = await getCollection("homes");

homes.sort((a, b) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;

  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  if (oa !== ob) return oa - ob;

  return a.data.title.localeCompare(b.data.title);
});

const allTags = Array.from(new Set(homes.flatMap((h) => h.data.tags ?? []))).sort((a, b) =>
  a.localeCompare(b)
);

const tagSlugToTag = new Map(allTags.map((t) => [toTagSlug(t), t]));

const tagSlug = Astro.params.tag;
const activeTag = tagSlug ? tagSlugToTag.get(norm(tagSlug)) ?? null : null;

if (!activeTag) {
  return Astro.redirect("/homes", 302);
}

// Tag-specific intro copy for SEO
const TAG_INTRO: Record<string, string> = {
  Modern:
    "Clean lines, open floor plans, and intentional simplicity. Explore modern custom homes designed around light, proportion, and livable space.",
  Contemporary:
    "Current architectural design with warmth and balance. Browse contemporary homes that blend modern form with timeless materials and detail.",
  "Indoor/Outdoor":
    "Homes designed to open and breathe—large openings, patios, and seamless transitions between interior and exterior living spaces.",
  "View Lot":
    "Designs shaped by the landscape. Explore homes composed to frame mountain, valley, and horizon views while preserving privacy and flow.",
  Pool:
    "Outdoor living planned from the start. Browse homes where pools, patios, and entertaining spaces are integrated into the overall design.",
  Courtyard:
    "Private outdoor spaces at the heart of the home. Explore courtyard designs that bring in light, air, and a sense of retreat.",
  Mountain:
    "Homes designed for alpine environments—natural materials, strong forms, and layouts that respond to elevation, climate, and views.",
  Desert:
    "Architecture shaped for high sun and open landscapes. Explore desert homes designed with shade, orientation, and material performance in mind.",
  Stone:
    "Stone used with intention—adding permanence, texture, and structure. Browse homes where stone anchors both interior and exterior design.",
  Timber:
    "Warm wood tones and crafted detail. Explore homes that use timber to bring depth, texture, and natural character to the architecture.",
  "Two Story":
    "Vertical layouts that separate living and private spaces while maximizing lot efficiency, light, and long-range views.",
  "Northern Utah":
    "Homes built for Wasatch Front living—seasonal performance, mountain views, and everyday comfort across Northern Utah communities.",
  "Southern Utah":
    "Designs tailored to red rock landscapes—heat-aware planning, natural materials, and outdoor-focused living in Southern Utah.",
};

const tagIntro = TAG_INTRO[activeTag] ?? "";

const filtered = homes.filter((h) => (h.data.tags ?? []).some((t) => norm(t) === norm(activeTag)));
const featuredHomes = filtered.filter((h) => h.data.featured);
const otherHomes = filtered.filter((h) => !h.data.featured);

const hasFeatured = featuredHomes.length > 0;
const hasOther = otherHomes.length > 0;
const totalCount = filtered.length;

// JSON-LD ItemList (matches display order: Featured first, then More Homes)
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;
const orderedHomes = [...featuredHomes, ...otherHomes];
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Utah Oasis Homes – ${activeTag} Homes`,
  itemListElement: orderedHomes.map((home, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/homes/${home.slug}`, siteOrigin).href,
    name: home.data.title,
    image: home.data.coverImage
      ? new URL(home.data.coverImage, siteOrigin).href
      : undefined,
  })),
};

// JSON-LD Breadcrumbs
const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", siteOrigin).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Our Homes",
      item: new URL("/homes", siteOrigin).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: activeTag,
      item: new URL(`/homes/tag/${tagSlug}`, siteOrigin).href,
    },
  ],
};
---

<BaseLayout
  title={`Homes with ${activeTag} | Utah Oasis Homes`}
  description={`Browse ${totalCount} Utah Oasis Homes tagged "${activeTag}".`}
>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbsJsonLd)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(itemListJsonLd)}
  />

  <section>
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol class="breadcrumbs-list">
        <li class="breadcrumbs-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumbs-separator">→</li>
        <li class="breadcrumbs-item">
          <a href="/homes">Our Homes</a>
        </li>
        <li class="breadcrumbs-separator">→</li>
        <li class="breadcrumbs-item breadcrumbs-current">
          {activeTag}
        </li>
      </ol>
    </nav>

    <div class="section-header">
      <div class="pill-eyebrow">Our Work</div>
      <h1 class="section-title">Our Homes</h1>
      <p class="section-subtitle">
        Showing <strong>{totalCount}</strong> home{totalCount === 1 ? "" : "s"} tagged{" "}
        <strong>{activeTag}</strong>.
      </p>
      {tagIntro ? (
        <p class="homes-tag-intro">{tagIntro}</p>
      ) : null}
    </div>

    {allTags.length ? (
      <div class="homes-filters" aria-label="Filter homes">
        <a class:list={["filter-chip"]} href="/homes">
          All
        </a>

        {allTags.map((t: string) => {
          const isActive = norm(t) === norm(activeTag);
          return (
            <a
              class:list={["filter-chip", isActive && "is-active"]}
              href={`/homes/tag/${toTagSlug(t)}`}
              aria-current={isActive ? "page" : undefined}
            >
              {t}
            </a>
          );
        })}
      </div>
    ) : null}

    {filtered.length === 0 ? (
      <p>No homes found for this tag.</p>
    ) : (
      <div class="homes-results">
        {hasFeatured ? (
          <>
            <h2 class="homes-subhead">Featured</h2>
            <div class="homes-grid homes-grid--featured">
              {featuredHomes.map((home) => (
                <HomeCard home={home} />
              ))}
            </div>
          </>
        ) : null}

        {hasOther ? (
          <>
            <h2 class="homes-subhead">More Homes</h2>
            <div class="homes-grid homes-grid--list">
              {otherHomes.map((home) => (
                <HomeCard home={home} />
              ))}
            </div>
          </>
        ) : null}
      </div>
    )}

  </section>
</BaseLayout>