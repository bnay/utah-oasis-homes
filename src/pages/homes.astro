---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const homes = await getCollection("homes");

const sortHomes = (a, b) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;

  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  if (oa !== ob) return oa - ob;

  return a.data.title.localeCompare(b.data.title);
};

homes.sort(sortHomes);

// Build tag list
const allTags = Array.from(
  new Set(homes.flatMap((h) => h.data.tags ?? []))
).sort((a, b) => a.localeCompare(b));

// Read filter from URL (?tag=Modern)
const tag = Astro.url.searchParams.get("tag");
const activeTag = tag && allTags.includes(tag) ? tag : null;

// Split featured + rest (after filtering)
const filtered = activeTag
  ? homes.filter((h) => (h.data.tags ?? []).includes(activeTag))
  : homes;

const featuredHomes = filtered.filter((h) => h.data.featured);
const otherHomes = filtered.filter((h) => !h.data.featured);
---

<BaseLayout
  title="Our Homes | Utah Oasis Homes"
  description="A curated selection of custom homes crafted by Utah Oasis Homes."
>
  <section>
    <div class="section-header">
      <div class="pill-eyebrow">Our Work</div>
      <h1 class="section-title">Our Homes</h1>
      <p class="section-subtitle">
        A selection of custom builds designed to feel like private resorts—crafted for Utah’s most inspiring landscapes.
      </p>
    </div>

{allTags.length ? (
  <div class="homes-filters" aria-label="Filter homes">
    <a class:list={["filter-chip", !activeTag && "is-active"]} href="/homes">
      All
    </a>

    {allTags.map((t) => {
      const isActive = activeTag === t;
      return (
        <a
          class:list={["filter-chip", isActive && "is-active"]}
          href={isActive ? "/homes" : `/homes?tag=${encodeURIComponent(t)}`}
          aria-current={isActive ? "true" : undefined}
        >
          {t}
        </a>
      );
    })}
  </div>
) : null}


{featuredHomes.length ? (
  <>
    <h2 class="homes-subhead">Featured</h2>
    <div class="homes-grid">
      {featuredHomes.map((home) => (
        <article class="home-card">
          <div class="home-card-media">
            <a href={`/homes/${home.slug}`} aria-label={`View ${home.data.title}`}>
              <img src={home.data.coverImage} alt={home.data.title} loading="lazy" />
            </a>
          </div>
          <div class="home-card-body">
            <h3 class="home-card-title">
              <a href={`/homes/${home.slug}`}>{home.data.title}</a>
            </h3>
            <div class="home-card-location">{home.data.location}</div>

            {home.data.tags?.length ? (
              <div class="tag-row">
                {home.data.tags.map((x) => <span class="tag">{x}</span>)}
              </div>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </>
) : null}

{otherHomes.length ? (
  <>
    <h2 class="homes-subhead">{featuredHomes.length ? "More Homes" : "Homes"}</h2>
    <div class="homes-grid">
      {otherHomes.map((home) => (
        <article class="home-card">
          <div class="home-card-media">
            <a href={`/homes/${home.slug}`} aria-label={`View ${home.data.title}`}>
              <img src={home.data.coverImage} alt={home.data.title} loading="lazy" />
            </a>
          </div>
          <div class="home-card-body">
            <h3 class="home-card-title">
              <a href={`/homes/${home.slug}`}>{home.data.title}</a>
            </h3>
            <div class="home-card-location">{home.data.location}</div>

            {home.data.tags?.length ? (
              <div class="tag-row">
                {home.data.tags.map((x) => <span class="tag">{x}</span>)}
              </div>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </>
) : (
  <p style="color: var(--muted); margin-top: 1.25rem;">
    No homes found{activeTag ? ` for “${activeTag}”.` : "."}
  </p>
)}

  </section>
</BaseLayout>
