---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import HomeCard from "../components/HomeCard.astro";


const homes = await getCollection("homes");

const toTagSlug = (t: unknown) =>
  String(t ?? "")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");


const sortHomes = (a: CollectionEntry<"homes">, b: CollectionEntry<"homes">) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;

  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  if (oa !== ob) return oa - ob;

  return a.data.title.localeCompare(b.data.title);
};

homes.sort(sortHomes);

// Build tag list (display values)
const allTags = Array.from(new Set(homes.flatMap((h) => h.data.tags ?? []))).sort((a, b) =>
  a.localeCompare(b)
);

// Read filter from URL (?tag=Modern)
const tag = Astro.url.searchParams.get("tag");

// Redirect legacy query-string filter URLs to the SEO-friendly route
if (tag) {
  return Astro.redirect(`/homes/tag/${toTagSlug(tag)}`, 301);
}

// /homes shows all homes (tag filtering lives on /homes/tag/[tag])
const filtered = homes;
const featuredHomes = filtered.filter((h) => h.data.featured);
const otherHomes = filtered.filter((h) => !h.data.featured);

// JSON-LD ItemList (matches display order: Featured first, then remaining homes)
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;
const orderedHomes = [...featuredHomes, ...otherHomes];

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Utah Oasis Homes – All Homes",
  itemListElement: orderedHomes.map((home, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/homes/${home.slug}`, siteOrigin).href,
    name: home.data.title,
    image: home.data.coverImage
      ? new URL(home.data.coverImage, siteOrigin).href
      : undefined,
  })),
};

// JSON-LD Breadcrumbs
const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", siteOrigin).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Our Homes",
      item: new URL("/homes", siteOrigin).href,
    },
  ],
};
---

<BaseLayout
  title="Custom Homes in Utah | Utah Oasis Homes"
  description="Explore custom homes built by Utah Oasis Homes across the Wasatch Front and Southern Utah, from mountain-connected family residences to desert retreats."
  canonicalPath="/homes"
>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbsJsonLd)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListJsonLd)}
  />

  <section class="homes-page">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol class="breadcrumbs-list">
        <li class="breadcrumbs-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumbs-separator">→</li>
        <li class="breadcrumbs-item breadcrumbs-current">
          Our Homes
        </li>
      </ol>
    </nav>

    <header class="portfolio-page-intro">
      <div class="portfolio-page-copy">
        <div class="pill-eyebrow">Our Work</div>
        <h1>Homes Shaped by People and Place</h1>
        <p>
          No two properties, families, or ambitions are the same. Explore custom residences across the
          Wasatch Front and Southern Utah—from mountain-connected family homes to desert retreats—each
          resolved through site-responsive design, direct builder involvement, and skilled execution.
        </p>

        <nav class="homes-region-links" aria-label="Explore homes by region">
          <a href="/custom-homes/utah-county">Wasatch Front & Utah County</a>
          <a href="/custom-homes/st-george">St. George & Southern Utah</a>
        </nav>
      </div>

      <div class="portfolio-page-visual" aria-label="A selection of custom homes by Utah Oasis Homes">
        {orderedHomes.slice(0, 3).map((home, index) => (
          <a
            class:list={["portfolio-page-image", index === 0 && "portfolio-page-image--primary"]}
            href={`/homes/${home.slug}`}
            aria-label={`View ${home.data.title}`}
          >
            <img
              src={home.data.coverImage}
              alt={`${home.data.title} in ${home.data.location}`}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </a>
        ))}
      </div>
    </header>

    <div class="portfolio-page-heading">
      <div>
        <div class="pill-eyebrow">Selected Homes</div>
        <h2>Designed for the people who live there</h2>
      </div>
      <p>Each home began with a particular family, property, and vision for everyday life.</p>
    </div>

{allTags.length ? (
  <div class="homes-filters" aria-label="Filter homes">
    <a
      class:list={["filter-chip", "is-active"]}
      href="/homes"
      aria-current="page"
      data-astro-reload
    >
      All
    </a>

    {allTags.map((t: string) => {
      
      return (
        <a
          class:list={["filter-chip"]}
          href={`/homes/tag/${toTagSlug(t)}`}
          data-astro-reload
        >
          {t}
        </a>
      );
    })}
  </div>
) : null}

{allTags.length ? (
  <p class="homes-filter-status">
    Showing all {homes.length} homes.
  </p>
) : null}

{featuredHomes.length ? (
  <>
    <h2 class="homes-subhead">Featured</h2>
    <div class="homes-grid">
      {featuredHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : null}

{otherHomes.length ? (
  <>
    <h2 class="homes-subhead">{featuredHomes.length ? "More Homes" : "Homes"}</h2>
    <div class="homes-grid">
      {otherHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : (
  <p style="color: var(--muted); margin-top: 1.25rem;">
    No homes found.
  </p>
)}

    <section class="portfolio-page-cta" aria-labelledby="portfolio-cta-title">
      <div>
        <div class="pill-eyebrow">Your Ideas, Your Home</div>
        <h2 id="portfolio-cta-title">Let’s talk about the home you’ve been imagining.</h2>
        <p>
          Share your property, priorities, and what would make the finished home feel distinctly yours.
        </p>
      </div>
      <a href="/start" class="btn btn-primary">Start Your Home</a>
    </section>

  </section>
</BaseLayout>
