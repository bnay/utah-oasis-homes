---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import HomeCard from "../components/HomeCard.astro";

// Keep this page SSR so we can 301 old query-string URLs to the new clean routes
export const prerender = false;

type Home = CollectionEntry<"homes">;

const homes = await getCollection("homes");

const toTagSlug = (t: unknown) =>
  String(t ?? "")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");


const sortHomes = (a: CollectionEntry<"homes">, b: CollectionEntry<"homes">) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;

  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  if (oa !== ob) return oa - ob;

  return a.data.title.localeCompare(b.data.title);
};

homes.sort(sortHomes);

// Build tag list (display values)
const allTags = Array.from(new Set(homes.flatMap((h) => h.data.tags ?? []))).sort((a, b) =>
  a.localeCompare(b)
);

// Read filter from URL (?tag=Modern)
const tag = Astro.url.searchParams.get("tag");

// Redirect legacy query-string filter URLs to the SEO-friendly route
if (tag) {
  return Astro.redirect(`/homes/tag/${toTagSlug(tag)}`, 301);
}

// /homes shows all homes (tag filtering lives on /homes/tag/[tag])
const filtered = homes;
const featuredHomes = filtered.filter((h) => h.data.featured);
const otherHomes = filtered.filter((h) => !h.data.featured);

---

<BaseLayout
  title="Our Homes | Utah Oasis Homes"
  description="A curated selection of custom homes crafted by Utah Oasis Homes."
>
  <section>
    <div class="section-header">
      <div class="pill-eyebrow">Our Work</div>
      <h1 class="section-title">Our Homes</h1>
      <p class="section-subtitle">
        A selection of custom builds designed to feel like private resorts—crafted for Utah’s most inspiring landscapes.
      </p>
    </div>

{allTags.length ? (
  <div class="homes-filters" aria-label="Filter homes">
    <a
      class:list={["filter-chip", "is-active"]}
      href="/homes"
      aria-current="page"
      data-astro-reload
    >
      All
    </a>

    {allTags.map((t: string) => {
      
      return (
        <a
          class:list={["filter-chip"]}
          href={`/homes/tag/${toTagSlug(t)}`}
          data-astro-reload
        >
          {t}
        </a>
      );
    })}
  </div>
) : null}

{featuredHomes.length ? (
  <>
    <h2 class="homes-subhead">Featured</h2>
    <div class="homes-grid">
      {featuredHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : null}

<p class="homes-filter-status">Showing all {homes.length} homes.</p>

{otherHomes.length ? (
  <>
    <h2 class="homes-subhead">{featuredHomes.length ? "More Homes" : "Homes"}</h2>
    <div class="homes-grid">
      {otherHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : (
  <p style="color: var(--muted); margin-top: 1.25rem;">
    No homes found.
  </p>
)}

  </section>
</BaseLayout>
