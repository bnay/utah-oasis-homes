---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import HomeCard from "../components/HomeCard.astro";


const homes = await getCollection("homes");

const toTagSlug = (t: unknown) =>
  String(t ?? "")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");


const sortHomes = (a: CollectionEntry<"homes">, b: CollectionEntry<"homes">) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;

  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  if (oa !== ob) return oa - ob;

  return a.data.title.localeCompare(b.data.title);
};

homes.sort(sortHomes);

// Build tag list (display values)
const allTags = Array.from(new Set(homes.flatMap((h) => h.data.tags ?? []))).sort((a, b) =>
  a.localeCompare(b)
);

// Read filter from URL (?tag=Modern)
const tag = Astro.url.searchParams.get("tag");

// Redirect legacy query-string filter URLs to the SEO-friendly route
if (tag) {
  return Astro.redirect(`/homes/tag/${toTagSlug(tag)}`, 301);
}

// /homes shows all homes (tag filtering lives on /homes/tag/[tag])
const filtered = homes;
const featuredHomes = filtered.filter((h) => h.data.featured);
const otherHomes = filtered.filter((h) => !h.data.featured);

// JSON-LD ItemList (matches display order: Featured first, then remaining homes)
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;
const orderedHomes = [...featuredHomes, ...otherHomes];

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Utah Oasis Homes – All Homes",
  itemListElement: orderedHomes.map((home, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/homes/${home.slug}`, siteOrigin).href,
    name: home.data.title,
    image: home.data.coverImage
      ? new URL(home.data.coverImage, siteOrigin).href
      : undefined,
  })),
};

// JSON-LD Breadcrumbs
const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", siteOrigin).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Our Homes",
      item: new URL("/homes", siteOrigin).href,
    },
  ],
};
---

<BaseLayout
  title="Our Homes | Utah Oasis Homes"
  description="Explore custom homes across Utah, each shaped by its setting, its owners, and the way they live."
  canonicalPath="/homes"
>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbsJsonLd)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListJsonLd)}
  />

  <section>
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol class="breadcrumbs-list">
        <li class="breadcrumbs-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumbs-separator">→</li>
        <li class="breadcrumbs-item breadcrumbs-current">
          Our Homes
        </li>
      </ol>
    </nav>

      <div class="section-header">
      <div class="pill-eyebrow">Our Work</div>
      <h1 class="section-title">Our Homes</h1>
      <p class="section-subtitle">
        A collection of custom homes shaped by their setting, their owners, and the way each family lives.
      </p>
    </div>

{allTags.length ? (
  <div class="homes-filters" aria-label="Filter homes">
    <a
      class:list={["filter-chip", "is-active"]}
      href="/homes"
      aria-current="page"
      data-astro-reload
    >
      All
    </a>

    {allTags.map((t: string) => {
      
      return (
        <a
          class:list={["filter-chip"]}
          href={`/homes/tag/${toTagSlug(t)}`}
          data-astro-reload
        >
          {t}
        </a>
      );
    })}
  </div>
) : null}

<p class="homes-filter-status">Showing all {homes.length} homes.</p>

{featuredHomes.length ? (
  <>
    <h2 class="homes-subhead">Featured</h2>
    <div class="homes-grid">
      {featuredHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : null}

{otherHomes.length ? (
  <>
    <h2 class="homes-subhead">{featuredHomes.length ? "More Homes" : "Homes"}</h2>
    <div class="homes-grid">
      {otherHomes.map((home) => <HomeCard home={home} />)}
    </div>
  </>
) : (
  <p style="color: var(--muted); margin-top: 1.25rem;">
    No homes found.
  </p>
)}

  </section>
</BaseLayout>
