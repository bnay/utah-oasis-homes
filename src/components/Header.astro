---
const currentPath = Astro.url.pathname;
const isStartPage = currentPath.startsWith("/start");
const siteTheme = import.meta.env.PUBLIC_SITE_THEME ?? "light";
const isLightTheme = siteTheme === "light";
const headerLogo = isLightTheme
  ? {
      src: "/branding/uoh-logo-orange-wide.png",
      width: 2823,
      height: 495,
    }
  : {
      src: "/branding/uoh-logo-blue-wide-lighter.png",
      width: 2718,
      height: 501,
    };
---

<div class="site-header-inner">
  <div class="nav-left">
    <a href="/" class="nav-logo" aria-label="Utah Oasis Homes home page">
      <img
        class="brand-logo"
        src={headerLogo.src}
        alt="Utah Oasis Homes"
        width={headerLogo.width}
        height={headerLogo.height}
        decoding="async"
      />
    </a>

    <div class="nav-separator" aria-hidden="true"></div>

    <a
      class="nav-phone"
      href="tel:+18018593317"
      aria-label="Call Utah Oasis Homes at 801-859-3317"
    >
      (801) 859-3317
    </a>
  </div>

  <nav class="nav-center" aria-label="Primary navigation">
    <a
      href="/"
      class:list={["nav-link", currentPath === "/" && "nav-link--active"]}
    >
      Home
    </a>

    <a
      href="/homes"
      class:list={[
        "nav-link",
        currentPath.startsWith("/homes") && "nav-link--active",
      ]}
    >
      Our Homes
    </a>

    <a
      href="/process"
      class:list={[
        "nav-link",
        currentPath.startsWith("/process") && "nav-link--active",
      ]}
    >
      How We Build
    </a>

    <a
      href="/about"
      class:list={[
        "nav-link",
        currentPath.startsWith("/about") && "nav-link--active",
      ]}
    >
      Who We Are
    </a>

        <a
      href="/client-stories"
      class:list={[
        "nav-link",
        currentPath.startsWith("/client-stories") && "nav-link--active",
      ]}
    >
      Client Stories
    </a>
  </nav>

  <div class="nav-right">
    <a
      href="/start"
      class:list={[
        "btn",
        "btn-primary",
        "nav-start-button",
        isStartPage && "nav-start-button--active",
      ]}
    >
      Start Your Home
    </a>

    <details class="nav-mobile">
      <summary
        class="nav-mobile-trigger"
        aria-label="Toggle navigation menu"
      >
        <span class="nav-mobile-burger" aria-hidden="true">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </span>

        <span class="nav-mobile-label">Menu</span>
      </summary>

      <nav class="nav-mobile-panel" aria-label="Mobile navigation">
        <a
          href="/"
          class:list={[
            "nav-mobile-link",
            currentPath === "/" && "is-active",
          ]}
        >
          Home
        </a>

        <a
          href="/homes"
          class:list={[
            "nav-mobile-link",
            currentPath.startsWith("/homes") && "is-active",
          ]}
        >
          Our Homes
        </a>

        <a
          href="/process"
          class:list={[
            "nav-mobile-link",
            currentPath.startsWith("/process") && "is-active",
          ]}
        >
          How We Build
        </a>

        <a
          href="/about"
          class:list={[
            "nav-mobile-link",
            currentPath.startsWith("/about") && "is-active",
          ]}
        >
          Who We Are
        </a>

        <a
          href="/client-stories"
          class:list={[
            "nav-mobile-link",
            currentPath.startsWith("/client-stories") && "is-active",
          ]}
        >
          Client Stories
        </a>

        <a
          href="/start"
          class:list={[
            "nav-mobile-link",
            "nav-mobile-start",
            isStartPage && "is-active",
          ]}
        >
          Start Your Home
        </a>

        <a
          href="tel:+18018593317"
          class="nav-mobile-phone"
        >
          Call (801) 859-3317
        </a>
      </nav>
    </details>
  </div>
</div>

<script>
  const mobileNav = document.querySelector(".nav-mobile");

  if (mobileNav instanceof HTMLDetailsElement) {
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.removeAttribute("open");
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        mobileNav.removeAttribute("open");
      }
    });

    document.addEventListener("click", (event) => {
      if (!mobileNav.hasAttribute("open")) return;

      const target = event.target;

      if (target instanceof Node && !mobileNav.contains(target)) {
        mobileNav.removeAttribute("open");
      }
    });
  }
</script>
